# BTMH Security Customer Release
BTMH_ENV=production
BTMH_NETWORK_MODE=local
MODULE_HOST=127.0.0.1
MCP_ENABLED=false
MCP_MODE=read_only
# Secrets are created during first-run setup and must not be committed here.
BTMH_PUBLIC_REGISTRATION=0
BTMH_LEGACY_OTP_ENABLED=0

# V5.4.10 native video gateway. Browser live view prefers MediaMTX/WHEP;
# Python WebRTC / zero-backlog WebSocket remain bounded compatibility fallbacks.
# These settings affect browser media only, never FaceID/PAD thresholds.
# BTMH_MEDIA_WEBRTC_FPS=15
# BTMH_MEDIA_WEBRTC_WIDTH=1280
# MODULE_WEBRTC_ENABLED=1

# V5.4.8 realtime profile for RTSP cameras.
# balanced: recommended for a normal laptop; quality: stronger PC; light: weak PC.
BTMH_RTSP_REALTIME_PROFILE=balanced
# Optional fine-tuning (leave commented to use the profile defaults):
# BTMH_RTSP_CAPTURE_FPS=18
# BTMH_RTSP_CAPTURE_MAX_WIDTH=1280
# BTMH_RTSP_AI_FPS=7
# BTMH_RTSP_AI_WIDTH=960
# BTMH_RTSP_PREVIEW_FPS=15
# BTMH_RTSP_PREVIEW_WIDTH=1280
# BTMH_RTSP_JPEG_QUALITY=78

# V5.4.10 native live video gateway. Camera credentials stay server-side.
BTMH_MEDIA_GATEWAY_ENABLED=1
BTMH_MEDIA_GATEWAY_HTTP_HOST=127.0.0.1
BTMH_MEDIA_GATEWAY_HTTP_PORT=8889
BTMH_MEDIA_GATEWAY_ICE_PORT=8189
BTMH_MEDIA_GATEWAY_API_PORT=9997
BTMH_MEDIA_GATEWAY_METRICS_PORT=9998

# Development AI/adaptive flags; retain all FaceID/PAD policy and models.
# Set to 0 only for scoped troubleshooting, then restart BTMH.
# BTMH_AI_ASYNC=1
# BTMH_AI_SUBSTREAM=1
# BTMH_ADAPTIVE_VIDEO_QUALITY=1
