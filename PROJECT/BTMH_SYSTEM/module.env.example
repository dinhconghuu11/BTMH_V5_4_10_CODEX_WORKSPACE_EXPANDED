# BTMH Security V5.2 Identity Only - FaceID / PostgreSQL / local-first Edge runtime
# Runtime paths are rewritten automatically by the installer.
CAMPUSFACE_DATA_ROOT=%LOCALAPPDATA%\CampusFace
CAMPUSFACE_DB_MODE=postgres
CAMPUSFACE_POSTGRES_HOST=127.0.0.1
CAMPUSFACE_POSTGRES_PORT=55442
CAMPUSFACE_POSTGRES_DB=campusface
CAMPUSFACE_POSTGRES_USER=campusface_app
CAMPUSFACE_POSTGRES_SSLMODE=disable
CAMPUSFACE_POSTGRES_BIN=%LOCALAPPDATA%\CampusFace\runtime\PostgreSQL17\bin
CAMPUSFACE_POSTGRES_DATA=%LOCALAPPDATA%\CampusFace\PostgreSQL\data
CAMPUSFACE_POSTGRES_LAUNCH_MODE=user-process

MODULE_PROFILE=MAX
MODULE_CAMERA_MODE=service
MODULE_CAMERA_SOURCE=0
MODULE_CAMERA_BACKEND=auto
MODULE_CAMERA_WIDTH=1920
MODULE_CAMERA_HEIGHT=1080
MODULE_CAMERA_FPS=30
MODULE_CAMERA_PREVIEW_FPS=25
BTMH_OBSERVATION_PREVIEW_FPS=20
BTMH_OBSERVATION_PREVIEW_WIDTH=1280
BTMH_OBSERVATION_JPEG_QUALITY=86
BTMH_OBSERVATION_PREVIEW_ENHANCE=1
BTMH_OBSERVATION_PREVIEW_SHARPEN=0.18
BTMH_OBSERVATION_PREVIEW_CONTRAST=1.05
BTMH_OBSERVATION_PREVIEW_BRIGHTNESS_TARGET=130
BTMH_OBSERVATION_FACE_AI_FPS=8
BTMH_OBSERVATION_FACE_AI_WIDTH=1280
BTMH_OBSERVATION_MAX_FACES=50
BTMH_OBSERVATION_IDENTITY_BUDGET=4
MODULE_CAMERA_FOURCC=auto
MODULE_CAMERA_AUTOFOCUS=1
MODULE_CAMERA_AUTO_EXPOSURE=1
MODULE_CAMERA_RECONNECT=1
MODULE_CAMERA_FAIL_LIMIT=8
MODULE_CAMERA_WARMUP_FRAMES=18

MODULE_AI_TARGET_FPS=12
MODULE_AI_WIDTH=1920
MODULE_AI_NATIVE_FRAME=1
MODULE_AI_NATIVE_MAX_WIDTH=1920
MODULE_MAX_FACES=10
MODULE_QUICK_REARM_SEC=2.60
MODULE_TRACK_TTL_SEC=3.2
MODULE_TRACK_DIST_MAX=2.4

MODULE_ENROLL_TARGET=8
MODULE_ENROLL_MIN_TOTAL=8
MODULE_ENROLL_SAMPLE_GAP_SEC=0.22


MODULE_USE_CUSTOM_FACE_YOLO=auto
MODULE_CUSTOM_YOLO_CONF=0.28
MODULE_CUSTOM_YOLO_IMGSZ=1280
MODULE_STORE_SNAPSHOTS=0
MODULE_ANTI_SPOOF=1
MODULE_ANTI_SPOOF_MODE=passive

# Legacy regression markers only; runtime values above are V1.14 defaults.

# V1.15 passive anti-spoof: no active blink/turn challenge.
MODULE_ANTI_SPOOF=1
MODULE_ANTI_SPOOF_MODE=passive

# V1 FACE context-first anti-spoof
MODULE_DEVICE_CONTEXT=1
MODULE_DEVICE_CONTEXT_CONF=0.26
MODULE_DEVICE_CONTEXT_IMGSZ=640
MODULE_DEVICE_CONTEXT_INTERVAL_SEC=0.18
MODULE_DEVICE_CONTEXT_HARD_RISK=0.88
MODULE_DEVICE_CONTEXT_SUSPECT_RISK=0.58

# Recoverable passive anti-spoof state machine
MODULE_ANTI_SPOOF_RECOVERY_SEC=0.55
MODULE_ANTI_SPOOF_RECOVERY_CLEAN_FRAMES=3
MODULE_ANTI_SPOOF_RECOVERY_CONTEXT_MAX=0.35

# V5.2 Identity-only recognition reliability
# Recognition duplicate protection when tracker IDs churn briefly.
CAMPUSFACE_SAME_CAMERA_DEDUP_SEC=300
CAMPUSFACE_CROSS_CAMERA_DEDUP_SEC=8
CAMPUSFACE_RECOGNITION_SESSION_DEDUP=1
CAMPUSFACE_UNKNOWN_EVENT_DEDUP_SEC=180
CAMPUSFACE_SPOOF_EVENT_DEDUP_SEC=180
CAMPUSFACE_SPOOF_PROMOTE_UNKNOWN_SEC=90
CAMPUSFACE_UNKNOWN_AFTER_SPOOF_HOLD_SEC=60

# Identity monitoring shares the existing camera/FaceID pipeline.
# The virtual gate remains disabled until it is configured and enabled in the web UI.
CAMPUSFACE_OFFICE_MODE=1
